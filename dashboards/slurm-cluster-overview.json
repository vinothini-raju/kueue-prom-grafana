    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "IDLE – Node is up and available, all CPUs are free.\n\nALLOCATED (alloc) – Node is fully allocated to one or more jobs (no free CPUs).\n\nMIXED – Node has some CPUs allocated to jobs and some still idle (partially used).\n\nDOWN / DOWN* – Node is marked down, typically due to hardware/software issues or admin action.\n\nDRAIN – Node is being drained; no new jobs will start, but running jobs continue until finished.\n\nRESERVED – Node is reserved for a future job or maintenance (not available for general scheduling).\n\nMAINT – Node is explicitly placed into maintenance mode by an admin.\n\nUNKNOWN – Node state cannot be determined (commonly a communication/config issue).",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 11,
        "x": 0,
        "y": 4
      },
      "id": 6,
      "options": {
        "displayMode": "basic",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "pluginVersion": "9.3.8",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "(\n  last_over_time(sum by (state) (slurm_node_count_per_state)[5m:])\n)\nor on (state) label_replace(vector(0), \"state\", \"idle\",  \"__name__\", \"\")\nor on (state) label_replace(vector(0), \"state\", \"mixed\", \"__name__\", \"\")\nor on (state) label_replace(vector(0), \"state\", \"alloc\", \"__name__\", \"\")\nor on (state) label_replace(vector(0), \"state\", \"down\",  \"__name__\", \"\")\nor on (state) label_replace(vector(0), \"state\", \"down*\", \"__name__\", \"\")\nor on (state) label_replace(vector(0), \"state\", \"drain\", \"__name__\", \"\")\n",
          "instant": true,
          "legendFormat": "{{state}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Nodes per State",
      "type": "bargauge"
    },
