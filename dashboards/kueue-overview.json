{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "iteration": 1723962000000,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Kueue scrape health",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Down", "color": "red" },
                "1": { "text": "Up", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "max(up{namespace=\"kueue-system\",pod=~\"kueue-controller-manager-.*\"})" }
      ]
    },
    {
      "type": "stat",
      "title": "Active admitted workloads (max over 5m)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum( max_over_time(kueue_admitted_active_workloads{cluster_queue=~\"$cluster_queue\"}[$__interval]) ) or vector(0)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Pods Pending now (Kueue-managed, in $kueue_ns)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum( max_over_time(kube_pod_status_phase{phase=\"Pending\", namespace=~\"$kueue_ns\"}[$__interval]) * on (namespace,pod) group_left() kube_pod_labels{label_kueue_x_k8s_io_podset!=\"\"} * on (namespace,pod) group_left(owner_kind) kube_pod_owner{owner_kind=\"Job\"} ) or on() vector(0)"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Jobs by status (now, Kueue-managed, in $kueue_ns)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "active",
          "expr": "sum( (kube_job_status_active{namespace=~\"$kueue_ns\"} > 0) * on (namespace, job_name) group_left() kube_job_annotations{annotation_kueue_x_k8s_io_queue_name!=\"\"} )"
        },
        {
          "refId": "B",
          "legendFormat": "succeeded",
          "expr": "sum( (kube_job_status_succeeded{namespace=~\"$kueue_ns\"} > 0) * on (namespace, job_name) group_left() kube_job_annotations{annotation_kueue_x_k8s_io_queue_name!=\"\"} )"
        },
        {
          "refId": "C",
          "legendFormat": "failed",
          "expr": "sum( (kube_job_status_failed{namespace=~\"$kueue_ns\"} > 0) * on (namespace, job_name) group_left() kube_job_annotations{annotation_kueue_x_k8s_io_queue_name!=\"\"} )"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pending workloads by status (Kueue)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{status}}",
          "expr": "sum by (status) (max_over_time(kueue_pending_workloads{cluster_queue=~\"$cluster_queue\"}[$__interval]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 admission attempt duration (s) by ClusterQueue",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{cluster_queue}}",
          "expr": "histogram_quantile(0.95, sum by (cluster_queue, le) (rate(kueue_admission_attempt_duration_seconds_bucket{cluster_queue=~\"$cluster_queue\",result=\"success\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Admission success ratio (15m) by ClusterQueue",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{cluster_queue}}",
          "expr": "sum by (cluster_queue) (increase(kueue_admission_attempts_total{result=\"success\",cluster_queue=~\"$cluster_queue\"}[$__rate_interval])) / clamp_min(sum by (cluster_queue) (increase(kueue_admission_attempts_total{cluster_queue=~\"$cluster_queue\"}[$__rate_interval])), 1)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pending pods by Job (Kueue-managed, in $kueue_ns)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{owner_name}} ({{namespace}})",
          "expr": "sum by (namespace, owner_name) ( max_over_time(kube_pod_status_phase{phase=\"Pending\", namespace=~\"$kueue_ns\"}[$__interval]) * on (namespace,pod) group_left(owner_kind,owner_name) kube_pod_owner{owner_kind=\"Job\"} * on (namespace,pod) group_left() kube_pod_labels{label_kueue_x_k8s_io_podset!=\"\"} )"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Evictions by reason (increase over 1h)",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{reason}}", "expr": "sum by (reason) (increase(kueue_evicted_workloads_total[$__range]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Active Kueue Jobs by name (in $kueue_ns)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{job_name}} ({{namespace}})",
          "expr": "sum by (namespace, job_name) ( max_over_time(kube_job_status_active{namespace=~\"$kueue_ns\"}[$__interval]) * on (namespace, job_name) group_left() kube_job_annotations{annotation_kueue_x_k8s_io_queue_name!=\"\"} )"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["kueue", "kubernetes", "scheduling"],
