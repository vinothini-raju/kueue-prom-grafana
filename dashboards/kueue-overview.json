{
  "id": 27,
  "uid": "5FjW5cXHz",
  "title": "Kueue Overview (Kueue + K8s views)",
  "tags": ["kueue", "kubernetes", "scheduling"],
  "timezone": "",
  "schemaVersion": 37,
  "version": 2,
  "refresh": "5s",
  "style": "dark",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "weekStart": "",
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "includeAll": true,
        "multi": false,
        "name": "cluster_queue",
        "query": {
          "query": "label_values(kueue_admission_attempts_total, cluster_queue)",
          "refId": "Prometheus-cluster_queue-Variable-Query"
        },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "includeAll": true,
        "label": "Namespaces with Kueue jobs",
        "multi": true,
        "name": "kueue_ns",
        "query": {
          "query": "label_values(kube_job_annotations{annotation_kueue_x_k8s_io_queue_name!=\"\"}, namespace)",
          "refId": "Prometheus-kueue_ns-Variable-Query"
        },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Kueue scrape health",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "max(up{namespace=\"kueue-system\",pod=~\"kueue-controller-manager-.*\"})", "refId": "A" }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "Down" },
                "1": { "color": "green", "text": "Up" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "9.3.8"
    },
    {
      "id": 2,
      "title": "Active admitted workloads (max over 5m)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum( max_over_time(kueue_admitted_active_workloads{cluster_queue=~\"$cluster_queue\"}[$__interval]) ) or vector(0)",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "9.3.8"
    },
    {
      "id": 3,
      "title": "Pods Pending now (Kueue-managed, in $kueue_ns)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(\n  max_over_time(kube_pod_status_phase{phase=\"Pending\", namespace=~\"$kueue_ns\"}[$__interval])\n  * on (namespace,pod) group_left()\n    count by (namespace,pod) (kube_pod_labels{label_kueue_x_k8s_io_podset!=\"\"})\n  * on (namespace,pod) group_left(owner_kind)\n    max by (namespace,pod,owner_kind) (kube_pod_owner{owner_kind=\"Job\"})\n) or on() vector(0)",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "9.3.8"
    },
    {
      "id": 4,
      "title": "Jobs by status (now, Kueue-managed, in $kueue_ns)",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum( (kube_job_status_active{namespace=~\"$kueue_ns\"} > 0) * on (namespace, job_name) group_left() kube_job_annotations{annotation_kueue_x_k8s_io_queue_name!=\"\"} )",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "sum( (kube_job_status_succeeded{namespace=~\"$kueue_ns\"} > 0) * on (namespace, job_name) group_left() kube_job_annotations{annotation_kueue_x_k8s_io_queue_name!=\"\"} )",
          "legendFormat": "succeeded",
          "refId": "B"
        },
        {
          "expr": "sum( (kube_job_status_failed{namespace=~\"$kueue_ns\"} > 0) * on (namespace, job_name) group_left() kube_job_annotations{annotation_kueue_x_k8s_io_queue_name!=\"\"} )",
          "legendFormat": "failed",
          "refId": "C"
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "pluginVersion": "9.3.8"
    },
    {
      "id": 5,
      "title": "Pending workloads by status (Kueue)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (max_over_time(kueue_pending_workloads{cluster_queue=~\"$cluster_queue\"}[$__interval]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 6,
      "title": "P95 admission attempt duration (s) by ClusterQueue",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (cluster_queue, le) (rate(kueue_admission_attempt_duration_seconds_bucket{cluster_queue=~\"$cluster_queue\",result=\"success\"}[$__rate_interval])))",
          "legendFormat": "{{cluster_queue}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 7,
      "title": "Admission success ratio (15m) by ClusterQueue",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (cluster_queue) (increase(kueue_admission_attempts_total{result=\"success\",cluster_queue=~\"$cluster_queue\"}[$__rate_interval])) / clamp_min(sum by (cluster_queue) (increase(kueue_admission_attempts_total{cluster_queue=~\"$cluster_queue\"}[$__rate_interval])), 1)",
          "legendFormat": "{{cluster_queue}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 8,
      "title": "Pending pods by Job (Kueue-managed, in $kueue_ns)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (namespace, owner_name) (\n  max_over_time(kube_pod_status_phase{phase=\"Pending\", namespace=~\"$kueue_ns\"}[$__interval])\n  * on (namespace,pod) group_left(owner_kind,owner_name)\n    max by (namespace,pod,owner_kind,owner_name) (kube_pod_owner{owner_kind=\"Job\"})\n  * on (namespace,pod) group_left()\n    count by (namespace,pod) (kube_pod_labels{label_kueue_x_k8s_io_podset!=\"\"})\n)",
          "legendFormat": "{{owner_name}} ({{namespace}})",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 9,
      "title": "Evictions by reason (increase over 1h)",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (reason) (increase(kueue_evicted_workloads_total[$__range]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "pluginVersion": "9.3.8"
    },
    {
      "id": 10,
      "title": "Active Kueue Jobs by name (in $kueue_ns)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (namespace, job_name) ( max_over_time(kube_job_status_active{namespace=~\"$kueue_ns\"}[$__interval]) * on (namespace, job_name) group_left() kube_job_annotations{annotation_kueue_x_k8s_io_queue_name!=\"\"} )",
          "legendFormat": "{{job_name}} ({{namespace}})",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    }
  ]
}
